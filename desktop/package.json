{
  "name": "carniwalls-pos",
  "version": "1.15.3",
  "description": "CarniWalls-POS Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "npm run prebuild && electron .",
    "dev": "powershell -Command \"$env:VITE_DEV_SERVER_URL='http://localhost:5173'; electron .\"",
    "prebuild": "npm run build --prefix ../client && powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }; Copy-Item -Recurse -Force ../client/dist ./dist\"",
    "build": "npm run prebuild && electron-builder",
    "publish": "npm run prebuild && electron-builder -p always",
    "electron:build": "npm run build",
    "electron:publish": "npm run publish"
  },
  "build": {
    "appId": "com.carniwalls.pos",
    "productName": "CarniWalls-POS",
    "electronVersion": "31.4.0",
    "icon": "../client/public/logo.png",
    "directories": {
      "output": "release",
      "buildResources": "../client/public"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mahidharchowdary2004",
        "repo": "Carniwalls-POS"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^26.8.1"
  }
}